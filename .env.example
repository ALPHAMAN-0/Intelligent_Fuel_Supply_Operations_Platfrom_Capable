# FuelOps configuration. Copy to .env (gitignored) and adjust:  cp .env.example .env
# Every backend/intelligence setting is an upper-case field of fuelops.shared.config.Settings; defaults shown.
# All data is SIMULATED. Never put real credentials or real fuel-infrastructure endpoints here.

# --- Operator access -------------------------------------------------------------------------------------------
# Bearer token the operator pastes on /login.html to approve/reject/modify plans and use the chaos drawer.
# Empty = operator actions disabled (HTTP 503). Use a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
OPERATOR_TOKEN=
# Token-gated proxy to the simulator's /admin/* for the demo chaos drawer (false = 403).
CHAOS_ENABLED=true
# Extra browser origins allowed to call the API (the console itself is same-origin on :8080).
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- Simulator (organizer image, compose service "simulator") --------------------------------------------------
# Wall-clock ticks per second while RUNNING (demo: 1-2). Simulated minutes per tick. paused | running at start.
SIMULATION_SPEED=1
TICK_MINUTES=15
SIMULATOR_START_MODE=running

# --- Simulator integration (backend) ----------------------------------------------------------------------------
# Compose sets SIM_BASE_URL=http://simulator:8000; set it here only when running the backend outside compose.
# SIM_BASE_URL=http://localhost:8000
SIM_CONNECT_TIMEOUT_S=2.0
SIM_READ_TIMEOUT_S=5.0
SIM_RETRIES=3
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RESET_TIMEOUT_S=10.0
# Polling interval when the SSE stream is down; SSE_ENABLED=false forces polling.
POLL_INTERVAL_MS=1000
SSE_ENABLED=true

# --- Storage (SQLite file, ADR-012) -----------------------------------------------------------------------------
# Compose keeps it on the backend-data volume (/srv/fuelops/server/data/fuelops.db).
# DATABASE_PATH=./data/fuelops.db

# --- Intelligence service -----------------------------------------------------------------------------------------
# Compose sets INTELLIGENCE_URL=http://intelligence:8090.
# INTELLIGENCE_URL=http://localhost:8090
INTELLIGENCE_TIMEOUT_S=3.0
# Forecast parameters are read from models/forecast-<MODEL_VERSION>.json (model rollback = change this).
MODEL_VERSION=v1

# --- Decisions ----------------------------------------------------------------------------------------------------
DECISIONS_ENABLED=true
# planner = LP via the intelligence service; heuristic = forced fallback / policy rollback.
PLANNER_POLICY=planner
# manual (every line reviewed) | assisted (auto-approve only confident, small lines) | auto
OPERATING_MODE=assisted
DECISION_EVERY_N_TICKS=1
# Planner horizon in ticks (4-96), demand quantile z (0-3), plan expiry in ticks.
PLAN_HORIZON_TICKS=24
PLAN_SAFETY_Z=1.0
PLAN_TTL_TICKS=2
MIN_SHIPMENT_L=1000
# Assisted-mode auto-approval gate: minimum line confidence (0-1) and maximum liters per line.
AUTO_APPROVE_MIN_CONFIDENCE=0.6
AUTO_APPROVE_MAX_LITERS=7000
HISTORY_WINDOW_TICKS=672
# Concurrent POST /api/evaluate (what-if LP) requests; extra ones get 429 + Retry-After.
EVALUATE_MAX_CONCURRENCY=4

# --- Explanations (Claude API; optional, deterministic templates are used without a key) --------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_S=30
# off | review (only plans that wait for a human) | all
LLM_AUTO_EXPLAIN=review

# --- Observability ------------------------------------------------------------------------------------------------
LOG_LEVEL=INFO
# Grafana admin password (anonymous users get read-only Viewer access to the dashboard).
GRAFANA_ADMIN_PASSWORD=

# --- Deploy / rollback --------------------------------------------------------------------------------------------
# Image used for backend + intelligence. Roll back with IMAGE_TAG=<previous sha> docker compose up -d.
IMAGE_REPO=fuelops-server
IMAGE_TAG=local

# --- Load test (docker compose --profile loadtest up locust) ------------------------------------------------------
LOAD_USERS=50
LOAD_SPAWN_RATE=5
LOAD_DURATION=3m
# Relative weight of token-gated what-if/compute requests in the mix (needs OPERATOR_TOKEN); 0 = read-only.
LOAD_WRITE_WEIGHT=1
